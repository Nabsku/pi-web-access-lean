{
  "name": "pi-web-access-lean",
  "version": "0.1.1",
  "description": "Lean web search, URL fetching, code search, GitHub repo cloning, and PDF extraction for Pi coding agent",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck index.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "fetch"
  ],
  "author": "Nico Bailon / lean fork",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nabsku/pi-web-access-lean.git"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "p-limit": "^7.3.0",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/node": "^26.0.1",
    "@types/turndown": "^5.0.6",
    "typescript": "^6.0.3",
    "typebox": "^1.3.4"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
